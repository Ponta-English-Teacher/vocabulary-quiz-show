# Copy to .env.local for local use (never commit real values; never prefix with NEXT_PUBLIC_).

# --- AI: OFF by default. Questions come from JSON files imported into the Word Bank. ---
# No OpenAI request is ever made (Studio generation, Japanese translation, pictures) unless VQS_OPENAI_ENABLED is exactly "true".
# A key on its own does NOT turn OpenAI on.
# VQS_OPENAI_ENABLED=true
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Teacher passcode: protects the Teacher Studio, OpenAI use and class-link creation. ---
# REQUIRED on Vercel (without it the teacher tools are locked). Optional on a private laptop.
TEACHER_PASSCODE=

# --- Shared classroom storage: REQUIRED on Vercel (serverless instances don't share memory). ---
# Added automatically by the Vercel Marketplace "Upstash Redis" integration. Locally these can stay unset
# (an in-memory store is used by `next start` on one laptop).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The integration may instead create KV_REST_API_URL / KV_REST_API_TOKEN — both names are supported.

# --- Sync Latest Bank (reads the approved question bank from Classroom Quiz Show; server-side only, never NEXT_PUBLIC_) ---
# Must equal BANK_SYNC_TOKEN in the Classroom Quiz Show project (32+ random characters). Without it the Sync button explains that sync is not set up.
CQS_SYNC_TOKEN=
# Optional: Classroom Quiz Show's address (https only; http allowed for localhost). Default: https://classroom-quiz-show.vercel.app
# CQS_BASE_URL=
