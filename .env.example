# Copy to .env.local for local use (never commit real values; never prefix with NEXT_PUBLIC_).

# --- AI (optional): enables REAL AI in the Teacher Studio. Leave unset to use the free mock AI. ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Teacher passcode: protects the Teacher Studio, OpenAI use and class-link creation. ---
# REQUIRED on Vercel (without it the teacher tools are locked). Optional on a private laptop.
TEACHER_PASSCODE=

# --- Shared classroom storage: REQUIRED on Vercel (serverless instances don't share memory). ---
# Added automatically by the Vercel Marketplace "Upstash Redis" integration. Locally these can stay unset
# (an in-memory store is used by `next start` on one laptop).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The integration may instead create KV_REST_API_URL / KV_REST_API_TOKEN — both names are supported.
